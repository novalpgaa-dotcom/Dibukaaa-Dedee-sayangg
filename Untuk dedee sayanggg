  <nav class="nav" aria-label="Navigasi slide">
    <button class="nav-btn prev" id="prev" type="button" aria-label="Slide sebelumnya">‹</button>
    <div class="dots" id="dots"></div>
    <button class="nav-btn next" id="next" type="button" aria-label="Slide berikutnya">›</button>
  </nav>

<script>
(function () {
  'use strict';

  const track    = document.getElementById('track');
  const deck     = document.getElementById('deck');
  const slides   = Array.from(document.querySelectorAll('.slide'));
  const dotsBox  = document.getElementById('dots');
  const progress = document.getElementById('progress');
  const prevBtn  = document.getElementById('prev');
  const nextBtn  = document.getElementById('next');

  const total = slides.length;
  let current = 0;

  /* ---------- Buat titik navigasi ---------- */
  slides.forEach((_, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'dot';
    b.setAttribute('aria-label', 'Buka slide ' + (i + 1));
    b.addEventListener('click', () => goTo(i));
    dotsBox.appendChild(b);
  });
  const dots = Array.from(dotsBox.children);

  /* ---------- Pindah slide ---------- */
  function goTo(i) {
    i = Math.max(0, Math.min(total - 1, i));
    current = i;

    track.style.transform = 'translate3d(' + (-i * 100) + '%, 0, 0)';

    slides.forEach((s, n) => s.classList.toggle('is-active', n === i));
    dots.forEach((d, n) => d.classList.toggle('is-active', n === i));

    progress.style.width = ((i + 1) / total * 100) + '%';

    const card = slides[i].querySelector('.card');
    if (card) card.scrollTop = 0;

    prevBtn.disabled = i === 0;
    nextBtn.disabled = i === total - 1;
  }

  prevBtn.addEventListener('click', () => goTo(current - 1));
  nextBtn.addEventListener('click', () => goTo(current + 1));

  /* ---------- Keyboard ---------- */
  document.addEventListener('keydown', (e) => {
    if (['ArrowRight', 'ArrowDown', 'PageDown', ' '].includes(e.key)) {
      e.preventDefault(); goTo(current + 1);
    } else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(e.key)) {
      e.preventDefault(); goTo(current - 1);
    } else if (e.key === 'Home') {
      e.preventDefault(); goTo(0);
    } else if (e.key === 'End') {
      e.preventDefault(); goTo(total - 1);
    }
  });

  /* ---------- Swipe (mobile) ---------- */
  let sx = 0, sy = 0, tracking = false;

  deck.addEventListener('touchstart', (e) => {
    const t = e.changedTouches[0];
    sx = t.clientX; sy = t.clientY; tracking = true;
  }, { passive: true });

  deck.addEventListener('touchend', (e) => {
    if (!tracking) return;
    tracking = false;
    const t = e.changedTouches[0];
    const dx = t.clientX - sx;
    const dy = t.clientY - sy;
    if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 50) {
      goTo(current + (dx < 0 ? 1 : -1));
    }
  }, { passive: true });

  /* ---------- Animasi Kelopak Bunga Melayang ---------- */
  (function petals() {
    const box = document.getElementById('petals');
    for (let i = 0; i < 20; i++) {
      const s = document.createElement('span');
      const size = (Math.random() * 8 + 6).toFixed(1);
      s.style.width = size + 'px';
      s.style.height = size + 'px';
      s.style.left = (Math.random() * 100).toFixed(2) + '%';
      s.style.bottom = (Math.random() * -20) + '%'; 
      s.style.opacity = (Math.random() * 0.4 + 0.3).toFixed(2);
      s.style.animationDuration = (Math.random() * 15 + 15).toFixed(1) + 's';
      s.style.animationDelay = (-Math.random() * 30).toFixed(1) + 's';
      box.appendChild(s);
    }
  })();

  /* ---------- Start ---------- */
  // Panggil goTo(0) langsung tanpa requestAnimationFrame ganda agar teks langsung muncul
  goTo(0);
})();
</script>
</body>
</html>
