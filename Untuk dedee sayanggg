<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#fff0f3" />
<title>Happy Birthday My Girlfriend</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Great+Vibes&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">

<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root{
    /* Warna Latar Belakang: Soft Pink & White */
    --bg-1:#fff0f3;
    --bg-2:#ffe5ec;
    --bg-3:#ffc2d1;
    
    /* Warna Teks: Espresso Soft (Solid) */
    --esp-dark:#3e2723;
    --esp-mid:#5d4037;
    --esp-lt:#8d6e63;

    --serif:'Playfair Display', Georgia, serif;
    --body:'Cormorant Garamond', Georgia, serif;
    --script:'Great Vibes', cursive;

    --ease-smooth:cubic-bezier(0.25, 1, 0.5, 1);
  }

  html, body { height: 100%; }

  body{
    font-family: var(--body);
    background: var(--bg-1);
    color: var(--esp-dark);
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* ================= LATAR BELAKANG SOFT ================= */
  .bg{
    position: fixed; inset: 0; z-index: -4;
    background:
      radial-gradient(120% 90% at 15% 5%,  rgba(255,194,209,.6) 0%, transparent 55%),
      radial-gradient(100% 80% at 90% 95%, rgba(255,229,236,.8) 0%, transparent 60%),
      radial-gradient(80% 70% at 50% 50%,  rgba(255,255,255,.9) 0%, transparent 70%),
      linear-gradient(155deg, var(--bg-1) 0%, var(--bg-2) 45%, var(--bg-3) 100%);
  }

  /* Ornamen Bunga Lily & Sulur (SVG Pattern) */
  .lily-motif {
    position: fixed;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    opacity: 0.15; 
    background-image: url("data:image/svg+xml,%3Csvg width='200' height='200' viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M50 150 Q80 100 150 50 M100 100 Q120 80 140 90 M60 180 Q90 150 130 130' stroke='%235d4037' stroke-width='1.5' fill='none' opacity='0.6'/%3E%3Cpath d='M145 45 C150 30 165 25 170 35 C175 45 165 60 150 55 C145 55 145 45 145 45 Z M150 55 C140 65 130 70 135 80 C140 90 155 85 155 75 C155 65 150 55 150 55 Z' fill='%235d4037' opacity='0.4'/%3E%3Ccircle cx='40' cy='160' r='3' fill='%235d4037' opacity='0.5'/%3E%3Ccircle cx='110' cy='110' r='2' fill='%235d4037' opacity='0.5'/%3E%3C/svg%3E");
    background-size: 300px 300px;
    animation: floatMotif 40s linear infinite;
  }

  @keyframes floatMotif {
    0% { background-position: 0px 0px; }
    100% { background-position: 300px 600px; }
  }

  .orb{
    position: fixed; border-radius: 50%;
    filter: blur(80px); z-index: -2;
    pointer-events: none; opacity: .8;
    will-change: transform;
  }
  .orb.a{
    width: 60vmax; height: 60vmax; left: -20vmax; top: -20vmax;
    background: radial-gradient(circle, rgba(255,255,255,.9), transparent 60%);
    animation: drift1 20s ease-in-out infinite alternate;
  }
  .orb.b{
    width: 50vmax; height: 50vmax; right: -15vmax; bottom: -20vmax;
    background: radial-gradient(circle, rgba(255,194,209,.6), transparent 65%);
    animation: drift2 25s ease-in-out infinite alternate;
  }
  @keyframes drift1{ to { transform: translate3d(5vmax, 5vmax, 0) scale(1.1); } }
  @keyframes drift2{ to { transform: translate3d(-5vmax, -5vmax, 0) scale(1.15); } }

  /* Kelopak Bunga Melayang */
  .petals{ position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .petals span{
    position: absolute;
    background: #fff;
    border-radius: 50% 0 50% 50%;
    box-shadow: 0 0 10px rgba(255,255,255,0.8);
    animation: floatPetal linear infinite;
  }
  @keyframes floatPetal{
    0%   { transform: translate3d(0, 0, 0) rotate(0deg); opacity: 0; }
    10%  { opacity: 0.8; }
    90%  { opacity: 0.8; }
    100% { transform: translate3d(30px, -150px, 0) rotate(360deg); opacity: 0; }
  }

  /* Vignette Putih */
  .vignette{
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(120% 100% at 50% 50%, transparent 50%, rgba(255,255,255,0.7) 100%);
  }

  /* ================= PROGRESS ================= */
  .progress{
    position: fixed; top: 0; left: 0; height: 3px; width: 0;
    z-index: 40; border-radius: 0 99px 99px 0;
    background: var(--esp-mid);
    transition: width 1.2s var(--ease-smooth);
  }

  /* ================= DECK / SLIDE ================= */
  .deck{
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    z-index: 10;
  }

  .track{
    display: flex;
    width: 100%;
    height: 100%;
    will-change: transform;
    transition: transform 1.2s var(--ease-smooth);
  }

  .slide{
    flex: 0 0 100%;
    min-width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 2.5rem);
    padding-bottom: clamp(6rem, 13vh, 8rem);
  }

  /* ================= KARTU (GLASSMORPHISM SOFT) ================= */
  .card{
    position: relative;
    width: min(880px, 100%);
    max-height: 100%;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    text-align: center;
    padding: clamp(1.8rem, 5vw, 3.6rem) clamp(1.3rem, 4.5vw, 3.2rem);
    border-radius: clamp(30px, 6vw, 60px);
    /* Warna background dibuat lebih solid (tidak terlalu transparan) agar teks aman */
    background: linear-gradient(165deg, rgba(255,255,255,.9) 0%, rgba(255,240,243,.8) 100%);
    border: 1.5px solid rgba(255,255,255,1);
    box-shadow:
      0 30px 60px -15px rgba(255, 194, 209, 0.4),
      0 10px 20px -5px rgba(93, 64, 55, 0.05);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    scrollbar-width: thin;
    scrollbar-color: rgba(141, 110, 99, 0.3) transparent;
  }
  .card::-webkit-scrollbar{ width: 5px; }
  .card::-webkit-scrollbar-thumb{
    background: rgba(141, 110, 99, 0.3); border-radius: 99px;
  }

  /* ================= TEKS ESPRESSO (SOLID & JELAS) ================= */
  .title{
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(1.9rem, 6.2vw, 3.6rem);
    line-height: 1.2;
    letter-spacing: .005em;
    color: var(--esp-dark) !important;
    text-shadow: 0 2px 5px rgba(255,255,255,0.9);
  }

  .title--md{ font-size: clamp(1.5rem, 4.8vw, 2.75rem); line-height: 1.3; }

  .lead{
    font-size: clamp(1.05rem, .95rem + .95vw, 1.5rem);
    line-height: 1.85;
    font-weight: 500;
    letter-spacing: .015em;
    color: var(--esp-mid) !important;
    text-shadow: 0 1px 3px rgba(255,255,255,0.8);
  }
  .lead--sm{ font-size: clamp(1rem, .88rem + .8vw, 1.35rem); line-height: 1.8; }

  .script{
    font-family: var(--script);
    font-weight: 400;
    font-size: clamp(2.3rem, 8vw, 4.5rem);
    line-height: 1.3;
    color: var(--esp-dark) !important;
    text-shadow: 0 4px 8px rgba(255,255,255,0.9);
  }

  /* ================= ORNAMEN BUNGA ================= */
  .ornament{
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(.8rem, 2.5vw, 1.5rem);
    margin: clamp(.9rem, 2.5vh, 1.8rem) 0;
  }
  .ornament span{
    height: 1.5px;
    width: clamp(40px, 12vw, 110px);
    background: linear-gradient(90deg, transparent, var(--esp-lt));
    border-radius: 99px;
  }
  .ornament span:last-child{
    background: linear-gradient(270deg, transparent, var(--esp-lt));
  }
  .ornament b{
    color: var(--esp-mid);
    font-size: 1.1rem;
    line-height: 1;
    text-shadow: 0 1px 2px #fff;
  }

  /* ================= ANIMASI REVEAL (TANPA BLUR) ================= */
  .reveal{
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s var(--ease-smooth),
      transform 1s var(--ease-smooth);
  }
  .slide.is-active .reveal{
    opacity: 1;
    transform: translateY(0);
  }
  .slide.is-active .reveal.d1{ transition-delay: .2s; }
  .slide.is-active .reveal.d2{ transition-delay: .4s; }
  .slide.is-active .reveal.d3{ transition-delay: .6s; }

  /* ================= NAVIGASI ================= */
  .nav{
    position: fixed;
    left: 50%;
    bottom: clamp(1rem, 3vh, 2rem);
    transform: translateX(-50%);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: clamp(.8rem, 2.5vw, 1.5rem);
    padding: .6rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
    border: 1.5px solid rgba(255, 255, 255, 1);
    box-shadow: 0 15px 35px -10px rgba(255, 194, 209, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    user-select: none;
  }

  .nav-btn{
    width: clamp(40px, 10vw, 48px);
    height: clamp(40px, 10vw, 48px);
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid rgba(141, 110, 99, 0.3);
    background: #fff;
    color: var(--esp-dark);
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(93, 64, 55, 0.08);
    transition: all .4s var(--ease-smooth);
  }
  .nav-btn:hover{
    background: var(--esp-dark);
    color: #fff;
    box-shadow: 0 8px 20px rgba(62, 39, 35, 0.3);
    transform: translateY(-3px);
  }
  .nav-btn:active{ transform: scale(.92); }
  .nav-btn:disabled{
    opacity: .3;
    cursor: default;
    transform: none;
    background: #fff;
    color: var(--esp-mid);
    box-shadow: none;
  }

  .dots{
    display: flex;
    align-items: center;
    gap: clamp(6px, 1.5vw, 10px);
  }

  .dot{
    width: 7px; height: 7px;
    border-radius: 50%;
    padding: 0;
    border: 1px solid var(--esp-lt);
    background: transparent;
    cursor: pointer;
    transition: all .5s var(--ease-smooth);
  }
  .dot:hover{ background: rgba(141, 110, 99, 0.5); }
  .dot.is-active{
    width: 26px;
    border-radius: 999px;
    border-color: transparent;
    background: var(--esp-dark);
    box-shadow: 0 2px 8px rgba(62, 39, 35, 0.4);
  }
</style>
</head>

<body>

  <div class="bg"></div>
  <div class="lily-motif"></div>
  <div class="orb a"></div>
  <div class="orb b"></div>
  <div class="petals" id="petals"></div>
  <div class="vignette"></div>

  <div class="progress" id="progress"></div>

  <main class="deck" id="deck">
    <div class="track" id="track">

      <!-- SLIDE 1 (Ditambahkan class is-active agar teks langsung muncul saat dibuka) -->
      <section class="slide is-active" aria-label="Slide 1">
        <div class="card">
          <div class="ornament reveal d1"><span></span><b>❀</b><span></span></div>
          <h1 class="title reveal d2">Dibuka Yaaaaaa</h1>
          <div class="ornament reveal d3"><span></span><b>❀</b><span></span></div>
        </div>
      </section>

      <!-- SLIDE 2 -->
      <section class="slide" aria-label="Slide 2">
        <div class="card">
          <div class="ornament reveal d1"><span></span><b>❀</b><span></span></div>
          <h2 class="title title--md reveal d2">
            Tadaaaaaaaaaa<br>
            Selamat Hari Ulang Tahun<br>
            Dedeee Sayangkuuuu
          </h2>
          <div class="ornament reveal d3"><span></span><b>❀</b><span></span></div>
        </div>
      </section>

      <!-- SLIDE 3 -->
      <section class="slide" aria-label="Slide 3">
        <div class="card">
          <p class="lead reveal d1">
            Dibaca yaa dan pahami karena babangg yang buatin ini 
