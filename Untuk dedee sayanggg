      <!-- SLIDE 10 -->
      <section class="slide" aria-label="Slide 10">
        <div class="card">
          <div class="ornament reveal d1"><span></span><b>❀</b><span></span></div>
          <h2 class="title title--md reveal d2">Eitttttt masih adaaa 1 slide lagi heheee</h2>
          <div class="ornament reveal d3"><span></span><b>❀</b><span></span></div>
